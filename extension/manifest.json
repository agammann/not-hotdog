{
  "manifest_version": 3,
  "name": "not hotdog",
  "version": "1.0.0",
  "description": "Hotdog or not hotdog, checked on your device. Enable hover separately for each tab. No API key or image upload.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "not hotdog"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"
  }
}
